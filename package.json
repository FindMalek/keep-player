{
  "name": "keep-player",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "mock": "bun test/mock/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test src scripts",
    "e2e": "playwright test",
    "size": "bun scripts/bundle-size.ts",
    "check": "bun run typecheck && bun run lint && bun run colors && bun run test && bun run size && bun scripts/config-docs.ts --check && bun scripts/shortcuts-docs.ts --check",
    "build": "bun scripts/build.ts",
    "config-docs": "bun scripts/config-docs.ts",
    "shortcuts-docs": "bun scripts/shortcuts-docs.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "colors": "bun scripts/check-colors.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/query-async-storage-persister": "5.104.2",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-query-persist-client": "5.104.2",
    "@tanstack/react-virtual": "3.14.19",
    "class-variance-authority": "0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.56.0",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.14.5",
    "recharts": "2.15.4",
    "sonner": "^2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "lighthouse": "13.5.0",
    "shadcn": "4.21.4",
    "typescript": "7.0.2"
  }
}
