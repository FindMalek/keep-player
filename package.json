{
  "name": "keep-player",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/api/src/server.ts",
    "start": "bun apps/api/src/server.ts",
    "mock": "bun test/mock/server.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "turbo run test && bun test scripts",
    "e2e": "playwright test",
    "size": "bun scripts/bundle-size.ts",
    "check": "bun run typecheck && bun run lint && bun run colors && bun run test && bun run size && bun scripts/config-docs.ts --check && bun scripts/shortcuts-docs.ts --check",
    "build": "bun scripts/build.ts",
    "config-docs": "bun scripts/config-docs.ts",
    "shortcuts-docs": "bun scripts/shortcuts-docs.ts",
    "screenshots": "bun scripts/screenshots.ts",
    "colors": "bun scripts/check-colors.ts",
    "demo:library": "bun scripts/demo-library.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "lighthouse": "13.5.0",
    "shadcn": "4.21.4",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "zod": "4.6.6"
  }
}
