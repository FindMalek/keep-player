{
  "name": "@keep/video",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts promo out/promo.mp4 --crf=16 --timeout=180000 --concurrency=3",
    "typecheck": "tsc --noEmit -p .",
    "render:vertical": "remotion render src/index.ts promo-vertical out/promo-vertical.mp4 --crf=16 --timeout=180000 --concurrency=3",
    "render:short": "remotion render src/index.ts short out/short.mp4 --crf=16 --timeout=180000 --concurrency=3",
    "render:short-vertical": "remotion render src/index.ts short-vertical out/short-vertical.mp4 --crf=16 --timeout=180000 --concurrency=3",
    "render:alt": "remotion render src/index.ts promo-alt out/promo-alt.mp4 --crf=16 --timeout=180000 --concurrency=3"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.539",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@keep/config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0"
  }
}
