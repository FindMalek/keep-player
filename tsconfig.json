{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./apps/player/src/*"],
      "@keep/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": ["apps", "packages", "test", "e2e", "scripts", "playwright.config.ts"]
}
