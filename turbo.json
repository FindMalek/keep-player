{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tsconfig.json",
        "package.json",
        "../../packages/config/tsconfig.base.json",
        "scripts/**",
        "source.config.ts",
        "../../docs/**"
      ]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "package.json"]
    },
    "build": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "public/**",
        "scripts/**",
        "next.config.ts",
        "source.config.ts",
        "postcss.config.mjs",
        "package.json",
        "../../packages/ui/src/**",
        "../../docs/**"
      ],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["SITE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
