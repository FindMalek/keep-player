{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tsconfig.json", "package.json", "../../packages/config/tsconfig.base.json"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "package.json"]
    },
    "build": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "public/**", "next.config.ts", "postcss.config.mjs", "package.json", "../../packages/ui/src/**"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": ["SITE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
